{
  "name": "replica-music",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "media": "python3 scripts/make_media.py",
    "seed": "tsx server/seed.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "setup": "npm run media && npm run seed && npm run build",
    "test:api": "node --test --import tsx tests/api.test.ts",
    "test:e2e": "npx vite build >/dev/null && playwright test --trace off",
    "test": "npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.1.0",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}