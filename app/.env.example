# Copy to .env.local and fill in. Never commit real values.
PORT=3001
NODE_ENV=production
# Public URL of the app, used in password reset links (e.g. https://yourdomain.com)
PUBLIC_URL=
# Shown in emails
APP_NAME=
# Where the SQLite file lives (use a persistent volume in production)
DATA_DIR=
# Set to 1 when running behind one reverse proxy (Fly, Render, Railway) so rate limits see real IPs
TRUST_PROXY=
# Transactional email via Resend (optional; without them reset links print to the server log)
RESEND_API_KEY=
MAIL_FROM=
# Payments (not wired yet; see replica/backend.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
