# Kingsley's secrets. install.sh copies this to ~/.hermes/profiles/kingsley/.env (chmod 600).
# Fill in every value, then restart the gateway: hermes -p kingsley gateway restart

# Brain (Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# His voice: https://elevenlabs.io (the voice HfRP3cIhYLmeNHeTvkWK must be in your ElevenLabs library)
ELEVENLABS_API_KEY=

# Telegram, his phone app. Easiest: desktop app or dashboard > Messaging > Telegram > "Create with QR",
# which fills these two in for you. TELEGRAM_ALLOWED_USERS must be ONLY your own Telegram user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Where scheduled results and approval requests land: your own Telegram user ID again.
TELEGRAM_HOME_CHANNEL=

# Instagram via Ootto (from your Ootto app's Claude / MCP connection settings)
OOTTO_MCP_URL=
OOTTO_MCP_KEY=
OOTTO_ACCOUNT_ID=acc_08d334bab95a

# Lovable website builds (through Claude Code): the name of your Lovable workspace.
LOVABLE_WORKSPACE=

# Approval calls. Your own mobile number, international format, e.g. +31612345678.
KINGSLEY_OWNER_PHONE=

# Twilio, Vapi: set these with the telephony skill's helper (see README step 5), which writes
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER, VAPI_API_KEY, VAPI_PHONE_NUMBER_ID here.
